GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here

# API key clients must send in the X-API-Key header to /query and /analytics.
# Leave blank to disable auth for local dev; set a strong value in production.
VERITAS_API_KEY=your_api_key_here

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veritas_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password

# Set to false to bypass the dev LLM response cache (data/llm_cache.json).
LLM_CACHE_ENABLED=true